# user-uploaded blog media (runtime, not source — lives on the server's local disk)
uploads/

# Generated feed exports (regenerate via `npm run pinterest:export` etc.) —
# not served from here; the server reads feeds from build/, generating them
# dynamically on request if no static copy is present. Committing these
# bloated the repo (and every deployed copy) with unused dead weight.
/assets/
/google-merchant-feed.csv
/pinterest-feed.csv
/pinterest-pins*.csv
